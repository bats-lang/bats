staload A = "array/src/lib.sats"
staload B = "builder/src/lib.sats"
staload F = "file/src/lib.sats"
staload R = "result/src/lib.sats"
staload SHA = "sha256/src/lib.sats"
staload S = "str/src/lib.sats"














































staload "helpers.sats"
staload "_bats_inputs.sats"













fn valid_context {l:agz}{n:pos}{lm:nat | lm <= n; lm <= 524288}
  (listing: !$A.arr(byte, l, n), lm: int lm)
  : [lk:agz] $A.arr(byte, lk, 64)



























fn valid_slot (name: $B.builder_v)
  : [cap:pos | cap <= 524288][k:nat | k <= cap][l:agz] @($A.arr(byte, l, cap), int k)














fn valid_slot_of_path {lp:agz}{np:pos}{pm:nat | pm <= np; pm <= 524288}
  (p: !$A.borrow(byte, lp, np), pm: int pm)
  : [cap:pos | cap <= 524288][k:nat | k <= cap][l:agz] @($A.arr(byte, l, cap), int k)















fn valid_holds {ls,lk:agz}{ns:pos}{sm:nat | sm <= ns; sm <= 524288}
  (slot: !$A.borrow(byte, ls, ns), sm: int sm, key: !$A.borrow(byte, lk, 64)): bool


















































































































fn valid_flush (pend: $B.builder_v): void














fn valid_file_key {lx,lp:agz}{np:pos}{pm:nat | pm <= np; pm <= 524288}
  (ctx: !$A.borrow(byte, lx, 64), reuse: bool, p: !$A.borrow(byte, lp, np), pm: int pm, is_unsafe: bool)
  : @(bool, [lk:agz] $A.arr(byte, lk, 64))
















fn valid_file_pend {lx,lp,ls,lk:agz}{np:pos}{pm:nat | pm <= np; pm <= 524288}{ns:pos}{sm:nat | sm <= ns}
  (ctx: !$A.borrow(byte, lx, 64), p: !$A.borrow(byte, lp, np), pm: int pm, is_unsafe: bool,
   slot: !$A.borrow(byte, ls, ns), sm: int sm, key: !$A.borrow(byte, lk, 64),
   pend: !$B.builder_v >> $B.builder_v): void


































fn valid_group_key {lx,lf:agz}{nf:pos}{fm:nat | fm <= nf; fm <= 524288}{off:nat | off <= fm}
  (ctx: !$A.borrow(byte, lx, 64), reuse: bool, files: !$A.borrow(byte, lf, nf), fm: int fm, off: int off, len: int)
  : @(bool, [lk:agz] $A.arr(byte, lk, 64))














fn valid_group_pend {lx,lf,ls,lk:agz}{nf:pos}{fm:nat | fm <= nf; fm <= 524288}{off:nat | off <= fm}{ns:pos}{sm:nat | sm <= ns}
  (ctx: !$A.borrow(byte, lx, 64), files: !$A.borrow(byte, lf, nf), fm: int fm, off: int off, len: int,
   slot: !$A.borrow(byte, ls, ns), sm: int sm, key: !$A.borrow(byte, lk, 64),
   pend: !$B.builder_v >> $B.builder_v): void








































fn uses_key {lp:agz}{np:pos}{pm:nat | pm <= np; pm <= 524288} (p: !$A.borrow(byte, lp, np), pm: int pm)
  : @(bool, [lk:agz] $A.arr(byte, lk, 64))
















fn uses_same {lp,lk:agz}{np:pos}{pm:nat | pm <= np; pm <= 524288}
  (p: !$A.borrow(byte, lp, np), pm: int pm, key: !$A.borrow(byte, lk, 64)): bool











fn facts_key {lp:agz}{np:pos}{path_length:nat | path_length <= np; path_length <= 524288} (path_bytes: !$A.borrow(byte, lp, np), path_length: int path_length)
  : @(bool, [lk:agz] $A.arr(byte, lk, 64))

fn facts_same {lp,lk:agz}{np:pos}{path_length:nat | path_length <= np; path_length <= 524288}
  (path_bytes: !$A.borrow(byte, lp, np), path_length: int path_length, key: !$A.borrow(byte, lk, 64)): bool

fn facts_slot {lp:agz}{np:pos}{path_length:nat | path_length <= np; path_length <= 524288} (path_bytes: !$A.borrow(byte, lp, np), path_length: int path_length)
  : [cap:pos | cap <= 524288][k:nat | k <= cap][l:agz] @($A.arr(byte, l, cap), int k)





























fn uses_slot {lp:agz}{np:pos}{pm:nat | pm <= np; pm <= 524288} (p: !$A.borrow(byte, lp, np), pm: int pm)
  : [cap:pos | cap <= 524288][k:nat | k <= cap][l:agz] @($A.arr(byte, l, cap), int k)












































fn uses_hit {ls,lk:agz}{ns:pos}{sm:nat | sm <= ns; sm <= 524288}
  (reuse: bool, slot: !$A.borrow(byte, ls, ns), sm: int sm, key: !$A.borrow(byte, lk, 64))
  : @(bool, $B.builder_v)


































fn uses_write {ls,lk,lb:agz}{ns:pos}{sm:nat | sm <= ns; sm <= 524288}{nb:pos}{len:nat | len <= nb}
  (slot: !$A.borrow(byte, ls, ns), sm: int sm, key: !$A.borrow(byte, lk, 64),
   body: !$A.borrow(byte, lb, nb), len: int len): void


















