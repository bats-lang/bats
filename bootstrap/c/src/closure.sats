datavtype dep =
  | {l:agz}{k:nat | k <= 256} Dep of ($A.arr(byte, l, 256), int k)


datavtype deps(int) =
  | deps_nil(0) of ()
  | {n:nat} deps_cons(n + 1) of (dep, deps(n))

fun deps_free {n:nat} (xs: deps(n)): void












fn put_dep (out: !$B.builder_v >> $B.builder_v, d: !dep): void











































































































































































































































fn dep_closure {le:agz} (entry: !$A.borrow(byte, le, 524288)): [r:nat] deps(r)














