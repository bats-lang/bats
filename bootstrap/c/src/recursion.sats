staload S = "str/src/lib.sats"






















staload "helpers.sats"
staload "lexer.sats"




































































































































































































































































































































































































































































































































































datavtype cycle_hits(int) =
  | cycle_hits_nil(0) of ()
  | {k:nat} cycle_hits_cons(k + 1) of (spos(524288), pos_t, pos_t, pos_t, cycle_hits(k))

fun cycle_hits_free {k:nat} (xs: cycle_hits(k)): void


















































datavtype cycles =
  | {h:nat} Cycles of (cycle_hits(h), bool)



fn implement_cycles {lf:agz}{off:nat | off <= 524288}
  (files: !$A.borrow(byte, lf, 524288), off: int off, len: int): cycles



















