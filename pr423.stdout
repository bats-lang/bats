diff --cc tests/capture-outcome/check.sh
index 0000000,37fa21b..f375d03
mode 000000,100755..100755
--- a/tests/capture-outcome/check.sh
+++ b/tests/capture-outcome/check.sh
@@@ -1,0 -1,54 +1,54 @@@
+ #!/bin/sh
+ # run_cmd_capture_outcome (bats-lang/bats#444, capture area): real children
+ # that write in pieces with pauses, more than a pipe holds, and exit non-zero
+ # give the outcomes of the type, apart; and a caller that ignores the
+ # "longer" case does not compile.
+ # usage: tests/capture-outcome/check.sh <bats-binary> <repository-dir>
+ set -u
+ BATS=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
+ REPO=$(cd "$2" && pwd)
+ HERE=$(cd "$(dirname "$0")" && pwd)
+ ROOT=$(cd "$HERE/../.." && pwd)
+ TMP=$(mktemp -d)
+ trap 'rm -rf "$TMP"' EXIT
+ fail() { echo "FAIL: $*" >&2; exit 1; }
+ # A copy of the compiler's project with the driver as a second binary
+ mkdir -p "$TMP/app"
+ cp -R "$ROOT/bats.toml" "$ROOT/src" "$TMP/app/"
+ [ ! -f "$ROOT/bats.lock" ] || cp "$ROOT/bats.lock" "$TMP/app/"
+ cp "$HERE/driver.bats" "$TMP/app/src/bin/capture-outcome.bats"
+ cd "$TMP/app"
+ "$BATS" build --repository "$REPO" > "$TMP/build.log" 2>&1 || { cat "$TMP/build.log"; fail "the driver did not build"; }
+ ./dist/debug/capture-outcome > "$TMP/got" 2>&1 || { cat "$TMP/got"; fail "the driver failed"; }
+ cat > "$TMP/want" <<'WANT'
+ old-form: status=3 len=3
+ small: fits 3
+ empty: fits 0
+ paused: fits 8
+ failed: failed status=3 kept=3
+ exact: fits 4096
+ one-over: longer status=0 written=4097
+ pieces: longer status=0 written=10000
+ longer-failed: longer status=5 written=10000
+ pipe-full: longer status=0 written=300000
+ stderr-heavy: fits 2
+ WANT
+ cat "$TMP/got"
+ diff "$TMP/want" "$TMP/got" || fail "outcomes differ"
+ # A caller that does not handle CaptureLonger is rejected
+ cat >> src/bin/capture-outcome.bats <<'BAD'
+ 
 -fn ignore_longer {le:agz}{lo:agz}
 -  (exec_bv: !$A.borrow(byte, le, 524288), argv: $L.listv($P.arg_entry),
++fn ignore_longer {le:agz}{lo:agz}{ne:pos}{cs:$A.cells}{k:nat | k < ne}
++  (nul: $P.NUL_AT(cs, ne, k) | exec_bv: !$A.cborrow(le, ne, cs), argv: $L.listv($P.arg_entry),
+    outbuf: !$A.arr(byte, lo, 4096)): int =
 -  case+ run_cmd_capture_outcome(exec_bv, argv, outbuf) of
++  case+ run_cmd_capture_outcome(nul | exec_bv, argv, outbuf) of
+   | ~CaptureFits(n) => n
+   | ~CaptureFailed(_, n) => n
+   | ~CaptureReadFailed(_, n, _) => n
+   | ~CaptureNotRun(_) => 0
+ BAD
+ if "$BATS" check --repository "$REPO" > "$TMP/bad.log" 2>&1; then
+   fail "a match without CaptureLonger was accepted"
+ fi
+ grep -q 'CaptureLonger\|non-exhaustive\|nonexhaustive\|exhaust' "$TMP/bad.log" || { cat "$TMP/bad.log"; fail "rejected, but not for the missing case"; }
+ echo "capture-outcome: ok"
diff --cc tests/capture-outcome/driver.bats
index 0000000,aa90af9..9213778
mode 000000,100644..100644
--- a/tests/capture-outcome/driver.bats
+++ b/tests/capture-outcome/driver.bats
@@@ -1,0 -1,67 +1,67 @@@
+ (* capture-outcome -- plays run_cmd_capture_outcome against real children (bats#444) *)
+ #target native
+ #include "share/atspre_staload.hats"
+ 
+ #use array as A
+ #use builder as B
+ #use list as L
+ #use process as P
+ 
+ staload "helpers.sats"
+ 
+ (* One child: sh -c <script>, its outcome printed as one line *)
+ fn play {sn:nat} (name: string, script: string sn): void = let
 -  val exec = str_to_path_arr("sh")
 -  val @(fz_x, bv_x) = $A.freeze<byte>(exec)
++  val (nul_x | exec) = $P.path_of_string_proved("sh")
++  val @(fz_x, bv_x) = $A.barr_freeze(exec)
+   var b1 = $B.create()
+   val () = bput_v(b1, "sh")
+   var b2 = $B.create()
+   val () = bput_v(b2, "-c")
+   var b3 = $B.create()
+   val () = bput_v(b3, script)
+   val out = $A.alloc<byte>(4096)
 -  val outcome = run_cmd_capture_outcome(bv_x, $L.list_vt_cons(mk_arg(b1),
++  val outcome = run_cmd_capture_outcome(nul_x | bv_x, $L.list_vt_cons(mk_arg(b1),
+     $L.list_vt_cons(mk_arg(b2), $L.list_vt_cons(mk_arg(b3), $L.list_vt_nil()))), out)
 -  val () = $A.drop<byte>(fz_x, bv_x)
 -  val () = $A.free<byte>($A.thaw<byte>(fz_x))
++  val () = $A.cborrow_drop(fz_x, bv_x)
++  val () = $A.barr_free($A.barr_thaw(fz_x))
+   val () = $A.free<byte>(out)
+ in
+   case+ outcome of
+   | ~CaptureFits(n) => println! (name, ": fits ", n)
+   | ~CaptureFailed(status, n) => println! (name, ": failed status=", status, " kept=", n)
+   | ~CaptureLonger(status, written) => println! (name, ": longer status=", status, " written=", written)
+   | ~CaptureReadFailed(status, n, _) => println! (name, ": read-failed status=", status, " kept=", n)
+   | ~CaptureNotRun(errno) => println! (name, ": not-run")
+ end
+ 
+ (* The old form, kept beside the new one for a version (repository-prototype#381) *)
+ fn play_old (): void = let
 -  val exec = str_to_path_arr("sh")
 -  val @(fz_x, bv_x) = $A.freeze<byte>(exec)
++  val (nul_x | exec) = $P.path_of_string_proved("sh")
++  val @(fz_x, bv_x) = $A.barr_freeze(exec)
+   var b1 = $B.create()
+   val () = bput_v(b1, "sh")
+   var b2 = $B.create()
+   val () = bput_v(b2, "-c")
+   var b3 = $B.create()
+   val () = bput_v(b3, "printf abc; exit 3")
+   val out = $A.alloc<byte>(4096)
 -  val @(status, n) = run_cmd_capture(bv_x, $L.list_vt_cons(mk_arg(b1),
++  val @(status, n) = run_cmd_capture(nul_x | bv_x, $L.list_vt_cons(mk_arg(b1),
+     $L.list_vt_cons(mk_arg(b2), $L.list_vt_cons(mk_arg(b3), $L.list_vt_nil()))), out)
 -  val () = $A.drop<byte>(fz_x, bv_x)
 -  val () = $A.free<byte>($A.thaw<byte>(fz_x))
++  val () = $A.cborrow_drop(fz_x, bv_x)
++  val () = $A.barr_free($A.barr_thaw(fz_x))
+   val () = $A.free<byte>(out)
+ in println! ("old-form: status=", status, " len=", n) end
+ 
+ implement main0 () = let
+   val () = play_old()
+   val () = play("small", "printf abc")
+   val () = play("empty", "true")
+   val () = play("paused", "printf aaaa; sleep 0.3; printf bbbb")
+   val () = play("failed", "printf abc; exit 3")
+   val () = play("exact", "head -c 4096 /dev/zero")
+   val () = play("one-over", "head -c 4097 /dev/zero")
+   val () = play("pieces", "i=0; while [ $i -lt 20 ]; do head -c 500 /dev/zero; sleep 0.05; i=$((i+1)); done")
+   val () = play("longer-failed", "head -c 10000 /dev/zero; exit 5")
+   val () = play("pipe-full", "head -c 300000 /dev/zero; sleep 0.2; exit 0")
+   val () = play("stderr-heavy", "head -c 300000 /dev/zero >&2; printf ok")
+ in end
